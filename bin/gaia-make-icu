#!/usr/bin/env bash
#
# gaia-make-icu
#

source "$GAIA_DIR/src/main/bash/gaia/init" || exit 2

[[ ! -d $ICU_DIR ]] && shell-error -e2 "`ICU_DIR` not set or is not a directory"

set -ex

build_dir=$ICU_DIR/build
lib_dir=$ICU_DIR/lib

toolchains=
if [[ $GAIA_LINUX ]]; then
  toolchains="gnu llvm"
elif [[ $GAIA_WINDOWS ]]; then
  toolchains="gnu"
fi

for toolchain in $toolchains; do
  [[ -d $build_dir ]] && rm -rfv $build_dir
  mkdir $build_dir
  cd $build_dir

  target=
  if [[ $GAIA_LINUX ]]; then
    if [[ $toolchain == gnu ]]; then
      target=Linux/gcc
    else
      target=Linux/clang
    fi
  else
    if [[ $toolchain == gnu ]]; then
      target=MinGW
    fi
  fi

  CXXFLAGS=-fPIC ../icu4c/source/runConfigureICU $target --disable-shared --enable-static

  set +x
  echo "################################################################################################"
  echo "#"
  echo "# Building ICU libraries for $toolchain-$build_type ..."
  echo "#"
  echo "################################################################################################"
  set -x

  make

  mkdir -p $lib_dir
  for file in $ICU_DIR/build/lib/*.a; do
    cp -v $file $lib_dir/$(gaia-stem $file)-$toolchain.a
  done
done

[[ -d $build_dir ]] && rm -rfv $build_dir

# EOF
