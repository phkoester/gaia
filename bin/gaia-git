#!/usr/bin/env bash

# gaia-git
#
# A wrapper around Git with additional convenience commands for Gaia projects.
#
# Usage:
#   gaia-git
#   gaia-git acp [-m MESSAGE]
#   gaia-git GIT_ARG...
#
# Before running any command, the script makes sure an `ssh-agent` is available, so Git can authenticate
# over SSH without asking for the passphrase again. It reuses the agent recorded in `~/.ssh-init`, or, if
# none is running, starts one and adds the default keys with `ssh-add`.
#
# Commands:
#
# - (none)
#     Runs `git status`
# - acp [-m MESSAGE]
#     Adds, commits, and pushes in one go, run from the top-level directory of a repository. Each step runs
#     only if it has something to do, and otherwise says so:
#     - Adds all changes with `git add .` if tracked files have unstaged changes or there are untracked
#       files that aren’t ignored
#     - Commits with MESSAGE if the index differs from `HEAD`. The default message is
#       `(No commit message.)`
#     - Pushes with `git push` if the current branch is ahead of its upstream. Fails if there is no
#       upstream
# - Anything else
#     Passes all arguments to `git` unchanged


source "$GAIA_DIR/src/main/bash/gaia/init" || exit 2

set -e

# Functions -------------------------------------------------------------------------------------------------

# Usage: has-diff [ARG]...
#
# Succeeds if `git diff --quiet ARG...` finds differences, fails if it finds none, and exits if `git diff`
# itself fails.
has-diff() {
  local status=0
  git diff --quiet "$@" || status=$?
  case $status in
    0) return 1 ;;
    1) return 0 ;;
    *) shell-error -e2 \`git diff --quiet $@\` failed with exit status $status ;;
  esac
}

# Main ------------------------------------------------------------------------------------------------------

ssh-init

if [[ $1 == "" ]]; then
  exec git status
elif [[ $1 == acp ]]; then
  # `acp` = add, commit, push

  [[ ! -e .git ]] && shell-error there is no Git repository in this directory

  shift
  eval "$(cl-get-opts m: "$@")"
  if [[ ! $m ]]; then
    m="(No commit message.)"
  fi
  # Add if there are unstaged changes to tracked files or untracked files that are not ignored
  untracked=$(git ls-files --others --exclude-standard)
  if has-diff || [[ $untracked ]]; then
    echo adding ...
    git add .
  else
    echo nothing to add
  fi
  # Commit if the index differs from `HEAD`. Without commits yet, the index is compared to the empty tree
  if has-diff --cached; then
    echo committing ...
    git commit -m"$m"
  else
    echo nothing to commit
  fi
  # Count the commits the upstream of the current branch doesn’t have yet. This fails if there is no upstream
  if ! ahead=$(git rev-list --count '@{upstream}..HEAD' 2>/dev/null); then
    shell-error the current branch has no upstream
  elif ((ahead > 0)); then
    echo pushing ...
    exec git push
  else
    echo nothing to push
  fi
else
  exec git "$@"
fi

# EOF
