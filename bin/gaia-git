#!/usr/bin/env bash
#
# gaia-git
#

source "$GAIA_DIR/src/main/bash/gaia/init" || exit 2

set -e

# Functions -------------------------------------------------------------------------------------------------

# Usage: has-diff [ARG]...
#
# Succeeds if `git diff --quiet ARG...` finds differences, fails if it finds none, and exits if `git diff`
# itself fails.
has-diff() {
  local status=0
  git diff --quiet "$@" || status=$?
  case $status in
    0) return 1 ;;
    1) return 0 ;;
    *) shell-error -e2 \`git diff --quiet $@\` failed with exit status $status ;;
  esac
}

# Main ------------------------------------------------------------------------------------------------------

ssh-init

if [[ $1 == "" ]]; then
  exec git status
elif [[ $1 == acp ]]; then
  # `acp` = add, commit, push

  [[ ! -e .git ]] && shell-error There is no Git repository in this directory

  shift
  eval "$(cl-get-opts m: "$@")"
  if [[ ! $m ]]; then
    m="(No commit message.)"
  fi
  # Add if there are unstaged changes to tracked files or untracked files that are not ignored
  untracked=$(git ls-files --others --exclude-standard)
  if has-diff || [[ $untracked ]]; then
    echo Adding ...
    git add .
  else
    echo Nothing to add
  fi
  # Commit if the index differs from `HEAD`. Without commits yet, the index is compared to the empty tree
  if has-diff --cached; then
    echo Committing ...
    git commit -m"$m"
  else
    echo Nothing to commit
  fi
  # Count the commits the upstream of the current branch doesn’t have yet. This fails if there is no upstream
  if ! ahead=$(git rev-list --count '@{upstream}..HEAD' 2>/dev/null); then
    shell-error The current branch has no upstream
  elif ((ahead > 0)); then
    echo Pushing ...
    exec git push
  else
    echo Nothing to push
  fi
else
  exec git "$@"
fi

# EOF
