#!/usr/bin/env bash
#
# gaia-git
#

source "$GAIA_DIR/src/main/bash/gaia/init" || exit 2

set -e

if [[ $1 == "" ]]; then
  exec git status
elif [[ $1 == acp ]]; then
  # `acp` = add, commit, push
  shift
  eval $(cl-get-options m: "$@")
  if [[ ! $m ]]; then
    m="(No commit message.)"
  fi
  if git status | grep -Eq "(Untracked files:|Changes not staged for commit:)"; then
    echo Adding unstaged ...
    git add .
  else
    echo Nothing to add
  fi
  if git status | grep -q "Changes to be committed:"; then
    echo Commiting ...
    git commit -m"$m"
  else
    echo Nothing to commit
  fi
  if git status | grep -q "Your branch is ahead of 'origin/main' by 1 commit."; then
    echo Pushing ...
    exec git push
  else
    echo Nothing to push
  fi
else
  exec git "$@"
fi

# EOF
