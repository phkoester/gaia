#!/usr/bin/env python3

# gaia-compile-defines

import argparse
import json
import re
import shlex
import sys

# Functions -------------------------------------------------------------------------------------------------

def compile_defines(input_file, pattern):
  regex = re.compile(pattern)
  with open(input_file, 'r', encoding='utf-8') as file:
    data = json.load(file)

  defines = {}
  for entry in data:
    if not regex.search(entry['file']):
      continue
    args = entry.get('arguments') or shlex.split(entry['command'])
    it = iter(args)
    for arg in it:
      if arg == '-D':
        # The definition is the next argument. A trailing `-D` without one is ignored
        define = next(it, None)
      elif arg.startswith('-D'):
        define = arg[2:]
      else:
        continue
      if define:
        defines[define.partition('=')[0]] = define

  return sorted(defines.values())

# `main` ----------------------------------------------------------------------------------------------------

def main():
  parser = argparse.ArgumentParser(
    description='Print the preprocessor definitions used in `compile_commands.json`.',
    formatter_class=argparse.RawDescriptionHelpFormatter
  )
  parser.add_argument('input_file', help='`compile_commands.json` file')
  parser.add_argument('pattern', help='regular expression pattern to match against the `file` field')
  args = parser.parse_args()

  print(' '.join(compile_defines(args.input_file, args.pattern)))
  return 0

if __name__ == '__main__':
  sys.exit(main())

# EOF
