#!/usr/bin/env python3
#
# gaia-compile-defines
#

"""
Print the preprocessor definitions used in `compile_commands.json`.

This script collects the `-D` options of all compilation commands whose file matches a regular expression
pattern, and prints them on one line, separated by spaces. The output can be used for Doxygen’s `PREDEFINED`.

Usage:
  gaia-compile-defines INPUT_FILE PATTERN

Arguments:
  INPUT_FILE  `compile_commands.json` file
  PATTERN     Regular expression pattern to match against the `file` field
"""

import argparse
import json
import re
import shlex
import sys

def compile_defines(input_file, pattern):
  regex = re.compile(pattern)
  with open(input_file, 'r', encoding='utf-8') as f:
    data = json.load(f)

  defines = {}
  for entry in data:
    if not regex.search(entry['file']):
      continue
    args = entry.get('arguments') or shlex.split(entry['command'])
    for i, arg in enumerate(args):
      define = args[i + 1] if arg == '-D' else arg[2:] if arg.startswith('-D') else None
      if define:
        defines[define.partition('=')[0]] = define

  return sorted(defines.values())

def main():
  parser = argparse.ArgumentParser(
    description='Print the preprocessor definitions used in `compile_commands.json`',
    formatter_class=argparse.RawDescriptionHelpFormatter,
    epilog=__doc__
  )
  parser.add_argument('input_file', help='`compile_commands.json` file')
  parser.add_argument('pattern', help='regular expression pattern to match against the `file` field')
  args = parser.parse_args()

  print(' '.join(compile_defines(args.input_file, args.pattern)))
  return 0

if __name__ == '__main__':
  sys.exit(main())

# EOF
