#
# Doxyfile-gaia
#

@INCLUDE = $(GAIA_DIR)/src/main/doxygen/Doxyfile-aliases

# TAGFILES --------------------------------------------------------------------------------------------------
#
# Download
#
#   https://github.com/PeterFeicht/cppreference-doc/releases/download/v20250209/html-book-20250209.zip
#
# Unzip, copy `cppreference-doxygen-web.tag.xml` to `$GAIA_DIR/src/main/doxygen`
#
# -----------------------------------------------------------------------------------------------------------

TAGFILES += "$(GAIA_DIR)/src/main/doxygen/cppreference-doxygen-web.tag.xml=https://en.cppreference.com/w/"

# Settings --------------------------------------------------------------------------------------------------

ALLOW_UNICODE_NAMES = YES
EXCLUDE_SYMBOLS     = internal
EXPAND_ONLY_PREDEF  = YES
GENERATE_LATEX      = NO
GENERATE_TREEVIEW   = YES
HAVE_DOT            = YES
JAVADOC_AUTOBRIEF   = NO
MACRO_EXPANSION     = YES
PREDEFINED          = $(DOXYGEN_PREDEFINED) # Set by `make doc` from `compile_commands.json`
RECURSIVE           = YES
TAB_SIZE            = 8
USE_MATHJAX         = YES
WARN_AS_ERROR       = NO
WARN_NO_PARAMDOC    = YES

# EOF
