#
# init-target-tuple
#
# Selects the default target tuple for the current host tuple and sets Gaia environment variables
# accordingly. These are
#
# - GAIA_TARGET_ARCH: aarch64, x86_64
# - GAIA_TARGET_VENDOR: apple, pc
# - GAIA_TARGET_OS: darwin, linux, windows
# - GAIA_TARGET (combines all of the above)
#
# Supported host tuples and their corresponding default target tuples are:
#
#   Host tuple             | Default target tuple
#   ---------------------- | --------------------
#   `aarch64-apple-darwin` | `aarch64-apple-darwin`
#   `x86_64-pc-linux`      | `x86_64-pc-linux`
#   `x86_64-pc-windows`    | `x86_64-pc-windows`
#
# Today, a tuple has up to 10 parts:
#
#   `tuple ::= arch [subarch] [_ endian] - vendor - os - libc [abi] [variant] [version] [- format]`
#
# As an example, `armv7k_be-arm-linux-gnueabihf6.3.3-macho` would be a 10-part tuple specifying:
#
#   Part      | Value   | Meaning
#   ----------+---------+--------
#   `arch`    | `arm`   | ARM
#   `subarch` | `v7k`   | v7k
#   `endian`  | `be`    | Big endian
#   `vendor`  | `arm`   | ARM Ltd
#   `os`      | `linux` | Linux
#   `libc`    | `gnu`   | GNU (glibc)
#   `abi`     | `eabi`  | EABI (embedded ABI)
#   `variant` | `hf`    | Hardware floating point
#   `version` | `6.3.3` | Version 6.3.3
#   `format`  | `macho` | Mach-O
#

# Select default target tuple -------------------------------------------------------------------------------

unset GAIA_TARGET_ARCH GAIA_TARGET_VENDOR GAIA_TARGET_OS GAIA_TARGET
export GAIA_TARGET_ARCH GAIA_TARGET_VENDOR GAIA_TARGET_OS GAIA_TARGET

if [[ $GAIA_HOST == aarch64-apple-darwin ]]; then
  # Darwin
  GAIA_TARGET_ARCH=aarch64
  GAIA_TARGET_VENDOR=apple
  GAIA_TARGET_OS=darwin
elif [[ $GAIA_HOST == x86_64-pc-linux ]]; then
  # Linux
  GAIA_TARGET_ARCH=x86_64
  GAIA_TARGET_VENDOR=pc
  GAIA_TARGET_OS=linux
elif [[ $GAIA_HOST == x86_64-pc-windows ]]; then
  # Windows
  GAIA_TARGET_ARCH=x86_64
  GAIA_TARGET_VENDOR=pc
  GAIA_TARGET_OS=windows
else
  echo init-target-tuple: error: Invalid host tuple: \`$GAIA_HOST\` >&2
  return 2
fi

GAIA_TARGET=$GAIA_TARGET_ARCH-$GAIA_TARGET_VENDOR-$GAIA_TARGET_OS

